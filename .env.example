# -----------------------------------------------------------------------------
# Service Buttler — environment configuration
# Copy to `.env` (for Vite) and `.dev.vars` (for Wrangler Pages Functions).
# Database (D1) and Storage (R2) bindings are configured in `wrangler.toml`.
# -----------------------------------------------------------------------------

# Optional: public base URL used when generating QR codes / NFC links.
# Defaults to the current browser origin.
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Resend API key & sender address (used for Magic Links and team invitations)
# Configure these as secrets in Cloudflare Pages for production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Service Buttler <onboarding@resend.dev>
