# -----------------------------------------------------------------------------
# Service Buttler — environment configuration
# Copy to `.env` and fill in values from Supabase → Project Settings → API.
# The same file is used by Vite (frontend) and by Wrangler (Pages Functions).
# -----------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser; data is protected by RLS)
VITE_SUPABASE_ANON_KEY=

# Optional: public base URL used when generating QR codes / NFC links.
# Defaults to the current browser origin.
VITE_PUBLIC_SITE_URL=
